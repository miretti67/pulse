// Cloudflare Workers + static assets. Built by `npm run build:cf` (Nitro cloudflare_module preset).
// Demo mode is baked ON (VITE_PULSE_DEMO=true) and auth OFF, so the preview needs no database:
// the simulator runs client-side; server functions fail gracefully.
{
  "name": "pulse",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [{ "type": "ESModule", "globs": ["**/*.mjs", "**/*.js"] }],
  "assets": { "binding": "ASSETS", "directory": ".output/public" },
  "vars": { "VITE_PULSE_DEMO": "true", "VITE_AUTH_ENABLED": "false" },
  "workers_dev": true
}
